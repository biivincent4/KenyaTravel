{
  "name": "kenya-travel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs README.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs README.md",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/http.e2e.ts",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "next": "16.4.2",
    "lucide-react": "^0.468.0",
    "stripe": "^20.0.0",
    "zod": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.20.0",
    "prettier": "^3.6.2",
    "typescript": "^5"
  }
}
