# Copy to .env.local. Never put real secrets in source control.
APP_URL=http://localhost:3000
# Relative to project root. Node creates the directory and seeds the catalog on first use.
# Built-in node:sqlite requires Node 22.13+ (Node 22 LTS recommended).
DATABASE_PATH=data\sanaa.sqlite
# Enable for HTTPS hosting. HTTPS APP_URL also automatically enables Secure cookies.
COOKIE_SECURE=false

# Optional: Google account sign-in (OAuth client type: Web application).
# Exact local authorized redirect URI:
# http://localhost:3000/api/auth/google/callback
# Set these only on the server; never use NEXT_PUBLIC_ for the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: real AI. Select exactly one provider; no automatic fallback.
# Omit AI_PROVIDER to preserve the original direct OpenAI behavior.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Use a model your account can access that supports tools and strict JSON schema.
OPENAI_MODEL=gpt-4.1-mini

# For Azure, set AI_PROVIDER=azure and configure all three values.
# HTTPS resource origin only (no /openai/v1 path or api-version query).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Azure deployment name, not necessarily the model family name.
AZURE_OPENAI_DEPLOYMENT=kenyatravel-gpt41mini

# Optional: Stripe test mode ONLY. Live keys are intentionally rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Do not leave admin provisioning credentials in .env.local.
# Supply ADMIN_EMAIL and ADMIN_PASSWORD temporarily in your terminal for admin:create.
